APP_NAME="Healthcare Node Registry"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=healthcare_node_registry
DB_USERNAME=registry
DB_PASSWORD=registry-development-only
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Healthcare Node Registry"

POSTGRES_DB=healthcare_node_registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry-development-only
